[Unit]
Description=Phase 8d news event predictions (paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/btc-phase8d
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/btc-predict/.venv/bin/python -m phase8d.cli predict --policy /opt/btc-phase8d/phase8d.policy.json --env-file /opt/btc-phase8a/.env.phase8a
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/btc-phase8d/data

[Install]
WantedBy=multi-user.target
