[Unit]
Description=Phase 8c prediction (paper only)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/btc-phase8c
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/btc-predict/.venv/bin/python -m phase8c.scheduled predict --schedule /opt/btc-phase8c/phase8c.schedule.json --env-file /opt/btc-phase8a/.env.phase8a
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/btc-phase8c/outputs
