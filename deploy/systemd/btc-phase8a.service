[Unit]
Description=BTC Phase 8a prospective news comparison and paper evaluation
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/btc-phase8a
EnvironmentFile=/opt/btc-phase8a/.env.phase8a
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/btc-predict/.venv/bin/python -m phase8a.cli tick --config /opt/btc-phase8a/phase8a.config.json --db /opt/btc-phase8a/phase8a.db --news-db /opt/btc-news/news.db --candles-db /opt/btc-predict/candles.db --live
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/btc-phase8a

