[Unit]
Description=Phase 8a hourly five-asset news prediction (paper only)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/btc-phase8a
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/btc-predict/.venv/bin/python -m phase8a.scheduled predict --schedule /opt/btc-phase8a/phase8a.schedule.json --env-file /opt/btc-phase8a/.env.phase8a
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/btc-phase8a
